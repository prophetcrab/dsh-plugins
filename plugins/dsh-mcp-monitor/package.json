{
  "name": "dsh-mcp-monitor",
  "version": "0.1.3",
  "description": "Read-only view of the MCP servers configured in this profile: connection state and registered tools.",
  "license": "MIT",
  "author": "prophetcrab",
  "homepage": "https://github.com/prophetcrab/dsh-plugins/tree/main/plugins/dsh-mcp-monitor",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prophetcrab/dsh-plugins.git",
    "directory": "plugins/dsh-mcp-monitor"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "mcp",
    "mcp-server",
    "monitor",
    "godot"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
